+    def _row_y_bounds(self, lines: torch.Tensor) -> torch.Tensor:
+        """Pixel-space vertical band owned by each trace row.
+
+        Rows are already sorted top-to-bottom (see ``_merge_nonoverlapping_lines``).
+        Each row's band is bounded by the midpoints to its neighbours' mean position,
+        rather than the row's own min/max excursion: a quiet rhythm strip can swing far
+        less than the space it occupies on the page, and the printed lead-name label
+        sits in that page space, not necessarily on the trace itself.
+
+        Must be called on ``lines`` before ``normalize()`` mean-centers it, since that
+        is what still carries each row's absolute position in the aligned image (the
+        same coordinate frame the lead-name U-Net runs on).
+        """
+        means: torch.Tensor = torch.nanmean(lines, dim=1)
+        midpoints: torch.Tensor = (means[:-1] + means[1:]) / 2
+        lo = torch.cat([means.new_tensor([float("-inf")]), midpoints])
+        hi = torch.cat([midpoints, means.new_tensor([float("inf")])])
+        return torch.stack([lo, hi], dim=1)
+
+    def _row_label_candidates(
+        self, probs: torch.Tensor, row_y_bounds: torch.Tensor
+    ) -> list[Optional[tuple[str, float]]]:
+        """For each trace row, the best-matching lead name printed in its own band.
+
+        The same lead name is often printed more than once on the page (e.g. "II" on
+        both the limb-lead row and a rhythm strip below it), and the two occurrences
+        can look alike enough (I/II/III in particular) to both light up one channel.
+        A single whole-image centroid per channel conflates such occurrences; taking
+        the max within each row's own band instead does not.
+
+        Args:
+            probs: Un-thresholded per-lead-name softmax probs, ``[1, 12, H, W]``.
+            row_y_bounds: Per-row (min_y, max_y) pixel bounds from ``_row_y_bounds``,
+                in the same pixel frame as ``probs``.
+
+        Returns:
+            One (lead_name, confidence) pair per row -- the highest-scoring channel
+            anywhere in that row's band -- or ``None`` for a row with no band.
+        """
+        arr: NDArray[Any] = probs[0].cpu().numpy()
+        height = arr.shape[1]
+        candidates: list[Optional[tuple[str, float]]] = []
+        for row_min, row_max in row_y_bounds.tolist():
+            lo = 0 if row_min == float("-inf") else max(0, int(row_min))
+            hi = height if row_max == float("inf") else min(height, int(row_max))
+            if hi <= lo:
+                candidates.append(None)
+                continue
+            band_max: NDArray[Any] = arr[:, lo:hi, :].max(axis=(1, 2))
+            best_channel = int(np.argmax(band_max))
+            candidates.append((self.LEAD_CHANNEL_ORDER[best_channel], float(band_max[best_channel])))
+        return candidates
+
